APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Visits report: city column on dbo.tbl_accounting_accounts (default fld_city)
# REPORTING_ACCOUNT_CITY_COLUMN=fld_city

# Optional: overlay Storage items + damages tier prices from EXEC dbo.SP_PDA_Get_Item_All_Units @USERID (read-only). Use a real tbl_accounting_accounts.fld_user_id_ref GUID.
# REPORTING_PDA_PRICING_USER_UUID=
# REPORTING_PDA_PRICING_SP=dbo.SP_PDA_Get_Item_All_Units
# REPORTING_PDA_PRICING_PICK_UNIT=max_scale

# Optional: tbl_store_items column that points to fld_store_item_unit_price_history_id (auto-detected if empty)
# REPORTING_STORE_ITEMS_PRICE_HISTORY_POINTER_COLUMN=fld_store_item_unit_price_history_id

# true = only price history on/before report as_of_date; false (default) = latest price change in DB regardless of as_of_date
# REPORTING_STORAGE_ITEMS_PRICE_HISTORY_CAP_AT_AS_OF_DATE=false

# Merge order when both master + history exist (master preference must stay true). Default: history first (matches active price-history vs stale master).
# REPORTING_STORAGE_ITEMS_PREFER_HISTORY_SALE_PRICES=true

# Treat tbl_store_items.fld_sale_priceN = 0 as missing so price history is used (fixes tier 5 showing 0 when history has the price)
# REPORTING_STORAGE_ITEMS_MASTER_SALE_PRICE_ZERO_AS_UNSET=true

# Damages: prefer last invoiced unit price for this client+item (before damage date). false = tier/price-list only
# REPORTING_DAMAGES_PRICE_PREFER_LAST_CLIENT_SALE=true

# App users (local SQLite file — not SQL Server). First account is created when the table is empty:
# REPORTS_USERS_SQLITE_DATABASE=database/reports-users.sqlite
# OPERATIONS_TASKS_SQLITE_DATABASE=database/operations-tasks.sqlite
# ACCOUNTING_SQLITE_DATABASE=database/accounting-local.sqlite
# PROMOTIONS_SQLITE_DATABASE=database/promotions-local.sqlite
# REPORTING_SQLITE_BACKUP_DIRECTORY=storage/app/sqlite-backups
# REPORTS_BOOTSTRAP_ADMIN_USERNAME=admin
# REPORTS_BOOTSTRAP_ADMIN_PASSWORD=2026@Akre@@

# Dashboard governorate (saved under Cities → Governorate breakdown)
# REPORTING_DASHBOARD_GOVERNORATE_NAME=Erbil
# REPORTING_DASHBOARD_GOVERNORATE_ID=0
# Set false to hide dashboard as-of date picker and always use live (today) metrics.
# DASHBOARD_LAB_HISTORICAL_DATES=true

# Extra non-working dates for dashboard-lab projections (Y-m-d, comma-separated; Fridays always excluded)
# REPORTING_NON_WORKING_HOLIDAYS=2026-03-20,2026-05-27
