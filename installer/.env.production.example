# Production template — the installer writes .env automatically.
# If .env is missing after install, run installer\create-env.cmd
# Replace INSTALL_PATH and passwords before use if editing manually.

APP_NAME="Reporting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlsrv
DB_HOST=10.10.10.250
DB_PORT=1433
DB_DATABASE=AsanAccounting
DB_USERNAME=Reporting
DB_PASSWORD="CHANGE_ME"
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true
DB_READONLY=true

DELIVERIES_SQLITE_DATABASE="INSTALL_PATH/database/deliveries-local.sqlite"
DAMAGES_SQLITE_DATABASE="INSTALL_PATH/database/damages-local.sqlite"
REPORTS_USERS_SQLITE_DATABASE="INSTALL_PATH/database/reports-users.sqlite"
OPERATIONS_TASKS_SQLITE_DATABASE="INSTALL_PATH/database/operations-tasks.sqlite"
ACCOUNTING_SQLITE_DATABASE="INSTALL_PATH/database/accounting-local.sqlite"
PROMOTIONS_SQLITE_DATABASE="INSTALL_PATH/database/promotions-local.sqlite"

REPORTS_BOOTSTRAP_ADMIN_USERNAME=admin
REPORTS_BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME"

REPORTING_DASHBOARD_GOVERNORATE_NAME=Erbil
REPORTING_DASHBOARD_GOVERNORATE_ID=0

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
